VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OAuth Client IDs (register apps in each platform's dev console)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_MICROSOFT_CLIENT_ID=your_microsoft_azure_app_client_id
VITE_JIRA_CLIENT_ID=your_jira_oauth_client_id
VITE_NOTION_CLIENT_ID=your_notion_integration_client_id
VITE_SLACK_CLIENT_ID=your_slack_app_client_id

# OAuth Redirect URI (must match what you register in each platform)
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
